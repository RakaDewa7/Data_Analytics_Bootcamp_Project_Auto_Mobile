      <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Customername' datatype='string' name='[CUSTOMERNAME]' role='dimension' type='nominal' />
      <column caption='Max Order Date' datatype='date' name='[Calculation_0886537510301697]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([ORDERDATE]) }' />
      </column>
      <column caption='Customer Last Order Date' datatype='date' name='[Calculation_0886537511227396]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [CUSTOMERNAME] : MAX([ORDERDATE]) }' />
      </column>
      <column caption='Recency' datatype='integer' name='[Calculation_0886537512308741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, &#13;&#10;{ FIXED [CUSTOMERNAME] : MAX([ORDERDATE]) }, &#13;&#10;{ FIXED : MAX([ORDERDATE]) })' />
      </column>
      <column caption='Frequency' datatype='integer' name='[Calculation_0886537512660998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [CUSTOMERNAME] : COUNTD([ORDERNUMBER]) }' />
      </column>
      <column caption='Monetary' datatype='real' default-format='C1033%' name='[Calculation_0886537512919047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[SALES]*[QUANTITYORDERED]' />
      </column>
      <column caption='Customer Segment' datatype='string' name='[Calculation_0886537514835977]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0886537512308741] &lt;= 90 AND [Calculation_0886537512660998] &gt;= 4 THEN &quot;Champions&quot;&#13;&#10;ELSEIF [Calculation_0886537512308741] &lt;= 180 AND [Calculation_0886537512660998] &gt;= 3 THEN &quot;Loyal Customers&quot;&#13;&#10;ELSEIF [Calculation_0886537512308741] &lt;= 180 AND [Calculation_0886537512660998] &lt; 3 THEN &quot;Potential Loyalists&quot;&#13;&#10;ELSEIF [Calculation_0886537512308741] &gt; 180 AND [Calculation_0886537512660998] &gt;= 3 THEN &quot;At Risk&quot;&#13;&#10;ELSE &quot;Hibernating Customers&quot;&#13;&#10;END' />
      </column>
      <column caption='Revenue' datatype='real' default-format='C1033%' name='[Calculation_0886537515814922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[QUANTITYORDERED]*[SALES]' />
      </column>
      <column caption='Persen Customer' datatype='real' default-format='p0.00%' name='[Calculation_1775768970035200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([CUSTOMERNAME])&#13;&#10;/&#13;&#10;TOTAL(COUNTD([CUSTOMERNAME]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Days Since Lastorder' datatype='integer' name='[DAYS_SINCE_LASTORDER]' role='measure' type='quantitative' />
